# ============================================================================
# tradex secrets vault 模板
#
# 复制到 ~/.tradex/secrets.toml 并收紧权限：
#
#   mkdir -p ~/.tradex
#   cp secrets.toml.example ~/.tradex/secrets.toml
#   chmod 700 ~/.tradex && chmod 600 ~/.tradex/secrets.toml
#
# watchlist.toml 里的密钥字段写成 "${VAR}" 引用，解析时先查本文件、再查同名
# 环境变量。在设置界面里粘贴密钥会自动写入本文件（并覆盖为机器管理格式，
# 注释不保留），明文永远不会写进 watchlist.toml。
#
# 下面是各配置块约定的变量名；只需填你实际用到的。
# ============================================================================

# [jin10] token — Jin10 MCP 数据源
JIN10_TOKEN = ""

# [macro] fred_api_key — https://research.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY = ""

# [macro] twelve_data_api_key — DXY / 现货金银报价（免费档 800 次/天）
TWELVE_DATA_API_KEY = ""

# [options.marketdata] api_key
MARKETDATA_API_KEY = ""

# [options.tradier] api_key
TRADIER_API_KEY = ""

# [proxy] password
PROXY_PASSWORD = ""

# [agent.providers.*] api_key — UI 粘贴时自动按 AGENT_<PROVIDER>_API_KEY 命名；
# 手写引用时变量名任意，与 watchlist.toml 中的 "${VAR}" 对应即可。
OPENAI_API_KEY = ""
ANTHROPIC_AUTH_TOKEN = ""
